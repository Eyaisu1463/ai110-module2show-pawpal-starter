classDiagram
    class Owner {
        +string name
        +string preferences
        +Pet[] pets
        +add_pet(pet)
        +get_all_tasks()
    }

    class Pet {
        +string name
        +string species
        +string breed
        +int age
        +string details
        +Task[] tasks
        +add_task(task)
        +get_tasks()
    }

    class Task {
        +string description
        +datetime time
        +string frequency
        +string status
        +int duration_minutes
        +string priority
        +mark_complete()
    }

    class Scheduler {
        +get_tasks(owner)
        +organize_tasks(owner)
        +generate_schedule(owner, available_minutes)
    }

    Owner "1" o-- "0..*" Pet : manages
    Pet "1" *-- "0..*" Task : has
    Scheduler ..> Owner : retrieves tasks for
    Scheduler ..> Pet : organizes tasks across
